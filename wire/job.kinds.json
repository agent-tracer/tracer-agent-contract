{
    "kinds": {
        "title.suggestion": {
            "agent": "title-suggestion",
            "executor": "temporal",
            "deadlineMs": 300000
        },
        "recipe.scan": {
            "agent": "recipe-scan",
            "executor": "temporal",
            "deadlineMs": 720000
        },
        "task.cleanup": {
            "agent": "task-cleanup",
            "executor": "temporal",
            "deadlineMs": 600000
        }
    },
    "statuses": {
        "values": [
            "pending",
            "running",
            "completed",
            "failed",
            "canceled"
        ],
        "terminal": [
            "completed",
            "failed",
            "canceled"
        ],
        "cancelable": [
            "pending",
            "running"
        ],
        "meaning": "canceled를 종료 상태에 두어야 종결 가드가 취소된 잡을 덮어쓰지 않는다"
    },
    "steps": {
        "roles": [
            "system",
            "user",
            "assistant",
            "tool",
            "orchestration"
        ],
        "orchestrationEventKinds": [
            "node.started",
            "node.completed",
            "node.failed",
            "route.selected",
            "validation.failed"
        ],
        "fields": {
            "seq": {
                "type": "integer",
                "minimum": 0
            },
            "role": {
                "type": "enum",
                "source": "steps.roles"
            },
            "content": {
                "type": "string"
            },
            "truncated": {
                "type": "boolean"
            },
            "toolCalls": {
                "type": "array",
                "item": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "args": {
                        "type": "object"
                    }
                }
            },
            "toolName": {
                "type": "string",
                "optional": true
            },
            "toolCallId": {
                "type": "string",
                "optional": true
            },
            "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "optional": true
            },
            "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "optional": true
            },
            "cacheReadTokens": {
                "type": "integer",
                "minimum": 0,
                "optional": true
            },
            "cacheCreationTokens": {
                "type": "integer",
                "minimum": 0,
                "optional": true
            },
            "stopReason": {
                "type": "string",
                "optional": true
            },
            "nodeName": {
                "type": "string",
                "optional": true
            },
            "eventKind": {
                "type": "enum",
                "source": "steps.orchestrationEventKinds",
                "optional": true
            },
            "durationMs": {
                "type": "number",
                "optional": true
            }
        },
        "roleMeaning": "orchestration은 모델도 도구도 아닌, 실행을 엮는 층이 낸 단계이며 nodeName과 eventKind가 그 자리에서만 실린다",
        "emptyStep": "content이 공백뿐이고 toolCalls도 비면 궤적에 아무 의미도 싣지 못하므로 적지 않는다"
    },
    "recipeScan": {
        "triggers": [
            "dashboard",
            "session"
        ],
        "meaning": "레시피 스캔을 요청한 표면이며 앵커 자격 판정이 여기서 갈린다"
    },
    "taskCleanup": {
        "suggestionKinds": [
            "archive"
        ],
        "suggestionStatuses": [
            "pending",
            "accepted",
            "dismissed"
        ],
        "maxSuggestions": 50,
        "maxEvidenceEventIds": 100
    },
    "deadlines": "kinds 의 deadlineMs 는 그 종류의 실행 하나가 쓸 수 있는 최대 시간이며 실행 봉투가 그 값을 실어 나른다"
}
