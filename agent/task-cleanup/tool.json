{
    "agent": "task-cleanup",
    "version": "v0.0.1",
    "limits": {
        "maxSuggestions": 50,
        "maxEvidenceEventIds": 100,
        "maxRedispatchRounds": 1,
        "triageCandidateListLimit": 100
    },
    "tools": {
        "get_task_events": {
            "description": "Get a page of a task's chronological event sequence (user messages, assistant messages, tool runs), up to 300 events per page. You choose how much to read: pick limit, pass the response's nextCursor back as cursor to keep paging, and set order=\"desc\" to start from the latest events (e.g. to see how a long task ended). truncated/total tell you whether more events exist. Call this whenever you need to see what actually happened in a task before judging it.",
            "args": {
                "taskId": {
                    "type": "string",
                    "required": true,
                    "trim": true,
                    "minLength": 1,
                    "description": "The task ID"
                },
                "limit": {
                    "type": "integer",
                    "required": false,
                    "min": 1,
                    "max": 300,
                    "default": 100,
                    "description": "Max events to return in this page (default 100, hard cap 300)"
                },
                "cursor": {
                    "type": "string",
                    "required": false,
                    "trim": true,
                    "description": "Opaque cursor from a previous call's nextCursor. Omit to start from the first page."
                },
                "order": {
                    "type": "enum",
                    "required": false,
                    "values": [
                        "asc",
                        "desc"
                    ],
                    "default": "asc",
                    "description": "Reading direction: \"asc\" (default) pages from the earliest event forward; \"desc\" pages from the latest event backward."
                }
            }
        }
    },
    "responses": {
        "get_task_events": {
            "page": [
                "events",
                "truncated",
                "nextCursor",
                "total"
            ],
            "item": [
                "id",
                "seq",
                "kind",
                "title",
                "body",
                "toolName",
                "filePaths",
                "occurredAt"
            ]
        }
    },
    "failures": {
        "toolFailed": "Tool {tool} failed: {reason}. Do not call it again more than once. Continue with the evidence you already have, and state in your rationale which evidence you could not check.",
        "workerFailed": "Investigation failed: {reason}"
    },
    "outputKinds": [
        "archive"
    ],
    "orchestration": {
        "workerMaxTurns": 4,
        "coordinatorTools": [],
        "emptyAssignmentEndsEmpty": true,
        "roles": {
            "cleanup-candidate-reviewer": [
                "get_task_events"
            ]
        },
        "workerReport": {
            "meaning": "검토 전문가 하나가 올리는 보고의 상한이며 모델이 읽는 자리에도 이 수가 실려야 한다.",
            "maxReasonChars": 400,
            "maxCitedEventIds": 6,
            "lengthUnit": "codePoint",
            "lengthUnitSource": "agent/shared/text.limits.json 이 단위의 정본이다."
        },
        "redispatchRequest": {
            "required": [
                "taskId",
                "depth"
            ],
            "maxTasks": 50
        },
        "inspectDepth": {
            "shallow": 1,
            "normal": 2,
            "deep": 4
        }
    },
    "candidateBatch": {
        "item": [
            "id",
            "visibleTitle",
            "status",
            "lastEventAt",
            "hasEvents",
            "activeChildCount",
            "candidateReasons"
        ]
    }
}
