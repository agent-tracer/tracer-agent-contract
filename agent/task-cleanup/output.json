{
    "agent": "task-cleanup",
    "version": "v0.0.1",
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "task.cleanup.suggestion.list",
        "type": "object",
        "required": [
            "suggestions"
        ],
        "properties": {
            "suggestions": {
                "type": "array",
                "maxItems": 50,
                "items": {
                    "type": "object",
                    "required": [
                        "kind",
                        "taskId",
                        "rationale",
                        "evidenceEventIds"
                    ],
                    "properties": {
                        "kind": {
                            "type": "string",
                            "const": "archive"
                        },
                        "taskId": {
                            "type": "string",
                            "trim": true,
                            "minLength": 1
                        },
                        "rationale": {
                            "type": "string",
                            "trim": true,
                            "minLength": 1,
                            "maxLength": 500
                        },
                        "evidenceEventIds": {
                            "type": "array",
                            "maxItems": 100,
                            "items": {
                                "type": "string",
                                "trim": true,
                                "minLength": 1
                            },
                            "description": "이벤트가 있는 태스크를 실제로 열어봤음을 증명하는 근거이며 빈 껍데기 후보는 빈 배열이 옳다"
                        }
                    }
                }
            }
        }
    }
}
