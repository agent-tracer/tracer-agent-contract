{
    "meaning": "모델마다 다른 출력 한도와 사고 설정을 실행 봉투가 싣게 하는 어휘와 스키마다. 값은 기능마다 다르므로 이 파일이 갖지 않고, 기능의 실행 한도 계약(각 에이전트의 tool.json 이나 구현체의 실행 카탈로그)이 모델 이름으로 이 스키마를 채운다.",
    "fields": {
        "maxOutputTokens": {
            "meaning": "모델 하나가 그 실행에서 낼 수 있는 출력 토큰 상한이다.",
            "perModel": true,
            "whenAbsent": "모델별 값이 없으면 그 기능의 실행 한도가 갖는 maxOutputTokens 를 쓴다."
        },
        "effort": {
            "meaning": "모델에 실어 보내는 추론 노력 수준이다.",
            "values": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
            ],
            "optional": true,
            "whenAbsent": "공급자의 기본값을 쓴다."
        },
        "thinking": {
            "meaning": "모델의 사고 모드를 켜고 끄는 신호다.",
            "values": [
                "adaptive",
                "disabled"
            ],
            "optional": true,
            "whenAbsent": "공급자의 기본값을 쓴다."
        }
    },
    "sharedOutputBudget": {
        "meaning": "일부 모델 계열은 사고가 기본으로 켜지고 maxOutputTokens 가 사고와 응답 텍스트를 합산한 상한이다.",
        "appliesTo": [
            "claude-opus-5"
        ],
        "consequence": "이 계열을 모델 카탈로그의 allowed 에 둔 기능은 출력 한도를 이 전제로 잡아야 한다. 그렇지 않으면 사고가 응답 몫을 먹어 maxOutputTokens 절단이 늘어난다."
    },
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "model.envelope",
        "type": "object",
        "additionalProperties": {
            "$ref": "#/$defs/perModel"
        },
        "$defs": {
            "perModel": {
                "type": "object",
                "properties": {
                    "maxOutputTokens": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "effort": {
                        "type": "string",
                        "enum": [
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max"
                        ]
                    },
                    "thinking": {
                        "type": "string",
                        "enum": [
                            "adaptive",
                            "disabled"
                        ]
                    }
                }
            }
        }
    }
}
