{
    "agent": "rule-generation",
    "version": "v0.0.1",
    "limits": {
        "maxBudgetUsd": 2,
        "maxOutputTokens": 8000,
        "deadlineMs": 720000,
        "effort": "medium"
    },
    "tools": {
        "get_task_turns": {
            "args": {
                "taskId": {
                    "type": "string",
                    "required": true,
                    "trim": true,
                    "minLength": 1
                }
            },
            "responseFields": [
                "turnId",
                "turnIndex",
                "askedText",
                "assistantSummary"
            ]
        },
        "get_task_events": {
            "args": {
                "taskId": {
                    "type": "string",
                    "required": true,
                    "trim": true,
                    "minLength": 1
                },
                "limit": {
                    "type": "integer",
                    "required": false,
                    "min": 1,
                    "max": 100,
                    "default": 50
                }
            },
            "responseFields": [
                "eventId",
                "turnId",
                "kind",
                "title",
                "body"
            ]
        },
        "list_rules": {
            "args": {},
            "responseFields": [
                "name",
                "expect"
            ]
        }
    },
    "maxTurns": 15,
    "workspaceTools": [
        "Read",
        "Glob",
        "Grep"
    ],
    "proposal": {
        "required": [
            "name",
            "expect",
            "citedTurnIds",
            "citedEventIds"
        ],
        "optional": [
            "severity",
            "rationale"
        ],
        "expectKinds": [
            "command",
            "pattern",
            "action"
        ],
        "citations": {
            "citedTurnIds": {
                "source": "get_task_turns",
                "min": 1,
                "max": 20
            },
            "citedEventIds": {
                "source": "get_task_events",
                "min": 0,
                "max": 20
            }
        }
    },
    "grounding": {
        "ledgerSources": [
            "get_task_turns",
            "get_task_events"
        ],
        "repairAttempts": 1,
        "onUngrounded": "drop"
    }
}
