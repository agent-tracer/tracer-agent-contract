            "startingRemainingBudgetUsd": 1.0,
            "reserve": { "turns": 2, "budgetShare": 0.2 },
            "afterReserve": { "remainingTurns": 8, "remainingBudgetUsd": 0.8 },
            "settle": { "costUsd": null, "numTurns": null },
            "expect": { "remainingTurns": 8, "remainingBudgetUsd": 0.8 }
        },
        "outputExclusivity": {
            "meaning": "recipes 와 redispatch 를 함께 실은 산출을 두 축이 같은 방식으로 거절하는지 본다.",
