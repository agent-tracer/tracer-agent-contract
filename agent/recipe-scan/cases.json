                    "name": "redispatch 만 채우면 통과한다",
                    "recipesNonEmpty": false,
                    "redispatchNonEmpty": true,
                    "expect": { "valid": true }
                },
                {
                    "name": "둘 다 비어 있으면 후보 없이 통과한다",
                    "recipesNonEmpty": false,
                    "redispatchNonEmpty": false,
                    "expect": { "valid": true }
                },
                {
                    "name": "recipes 와 redispatch 를 함께 채우면 거절한다",
                    "recipesNonEmpty": true,
                    "redispatchNonEmpty": true,
                    "expect": { "valid": false }
                }
            ]
