{
    "agent": "recipe-scan",
    "limits": {
        "candidateLimit": 4
    },
    "steps": {
        "consecutiveFromOne": true
    },
    "verify": {
        "kinds": [
            "command",
            "pattern",
            "action"
        ],
        "command": {
            "matchesMin": 1,
            "matchesMax": 20
        },
        "pattern": {
            "maxLength": 500
        },
        "action": {
            "tools": [
                "command",
                "file-read",
                "file-write",
                "web"
            ]
        }
    },
    "orchestration": {
        "workerMaxTurns": 10,
        "maxRedispatchRounds": 1,
        "coordinatorTools": [
            "check_citations"
        ],
        "roles": {
            "timeline": [
                "get_task_summary",
                "get_task_events",
                "search_events",
                "check_citations"
            ],
            "rules": [
                "list_rules",
                "search_recipes",
                "check_citations"
            ],
            "repetition": [
                "search_events",
                "find_similar_tasks",
                "check_citations"
            ]
        },
        "workerReport": {
            "required": [
                "probe",
                "verdict",
                "excerpts",
                "exhausted"
            ],
            "excerptRequired": [
                "taskId",
                "eventId",
                "text"
            ]
        },
        "redispatchRequest": {
            "required": [
                "probe",
                "weight",
                "question"
            ],
            "maxProbes": 3
        }
    },
    "tools": {
        "get_task_summary": {
            "required": [
                "taskId"
            ],
            "optional": [
                "window"
            ],
            "numbers": {
                "window": {
                    "default": 400,
                    "min": 1,
                    "max": 2000
                }
            }
        },
        "get_task_events": {
            "required": [
                "taskId"
            ],
            "optional": [
                "limit",
                "cursor",
                "order"
            ],
            "numbers": {
                "limit": {
                    "default": 100,
                    "min": 1,
                    "max": 300
                }
            },
            "enums": {
                "order": {
                    "default": "asc",
                    "values": [
                        "asc",
                        "desc"
                    ]
                }
            }
        },
        "list_rules": {
            "required": [
                "taskId"
            ],
            "optional": []
        },
        "search_events": {
            "required": [
                "q"
            ],
            "optional": [
                "taskId",
                "kind",
                "toolName",
                "limit",
                "offset"
            ],
            "numbers": {
                "limit": {
                    "default": 20,
                    "min": 1,
                    "max": 100
                },
                "offset": {
                    "default": 0,
                    "min": 0,
                    "max": 9900
                }
            },
            "enums": {
                "kind": {
                    "values": [
                        "execute_tool",
                        "plan",
                        "agent_tracer.action.logged",
                        "agent_tracer.rule.logged",
                        "agent_tracer.thought.logged",
                        "agent_tracer.context.saved",
                        "agent_tracer.context.snapshot",
                        "agent_tracer.user.prompt.expansion",
                        "agent_tracer.permission.request",
                        "agent_tracer.worktree.remove",
                        "agent_tracer.setup.triggered",
                        "agent_tracer.file.changed",
                        "agent_tracer.user.message",
                        "agent_tracer.assistant.commentary",
                        "agent_tracer.assistant.response",
                        "agent_tracer.question.logged",
                        "agent_tracer.todo.logged",
                        "invoke_agent",
                        "agent_tracer.instructions.loaded"
                    ]
                }
            },
            "responseEvent": {
                "required": [
                    "id",
                    "taskId",
                    "seq",
                    "kind",
                    "title",
                    "filePaths",
                    "occurredAt"
                ],
                "optional": [
                    "body",
                    "toolName"
                ]
            }
        },
        "find_similar_tasks": {
            "required": [
                "anchorTaskId"
            ],
            "optional": [
                "limit"
            ],
            "numbers": {
                "limit": {
                    "default": 5,
                    "min": 1,
                    "max": 20
                }
            }
        },
        "search_recipes": {
            "required": [
                "q"
            ],
            "optional": [
                "limit"
            ],
            "numbers": {
                "limit": {
                    "default": 5,
                    "min": 1,
                    "max": 20
                }
            }
        },
        "check_citations": {
            "required": [
                "taskId"
            ],
            "optional": [
                "eventIds",
                "turnIds",
                "ruleIds"
            ]
        }
    },
    "responses": {
        "get_task_events": {
            "page": [
                "events",
                "truncated",
                "nextCursor",
                "total"
            ],
            "item": [
                "id",
                "seq",
                "turnId",
                "kind",
                "title",
                "body",
                "toolName",
                "filePaths",
                "occurredAt"
            ]
        }
    },
    "failures": {
        "toolFailed": "Tool {tool} failed: {reason}. Do not call it again more than once. Continue with the evidence you already have, and state in your rationale which evidence you could not check.",
        "workerFailed": "Investigation failed: {reason}"
    },
    "argDescriptions": {
        "get_task_summary": {
            "taskId": "The task ID",
            "window": "How many of the task's earliest events to aggregate (default 400, hard cap 2000)"
        },
        "get_task_events": {
            "taskId": "The task ID",
            "limit": "Max events to return in this page (default 100, hard cap 300)",
            "cursor": "Opaque cursor from a previous call's nextCursor. Omit to start from the first page.",
            "order": "Reading direction: \"asc\" (default) pages from the earliest event forward; \"desc\" pages from the latest event backward."
        },
        "list_rules": {
            "taskId": "The anchor task ID"
        },
        "search_events": {
            "q": "Search query",
            "taskId": "Optional task ID filter",
            "kind": "Optional event kind filter. Must be one of the known event kinds.",
            "toolName": "Optional tool name filter",
            "limit": "Max results per call",
            "offset": "How many ranked results to skip; combine with limit to page beyond the first batch"
        },
        "find_similar_tasks": {
            "anchorTaskId": "The anchor task ID",
            "limit": "Max tasks"
        },
        "search_recipes": {
            "q": "Search query",
            "limit": "Max recipes"
        },
        "check_citations": {
            "taskId": "The task the cited IDs belong to",
            "eventIds": "Event IDs you intend to cite",
            "turnIds": "Turn IDs you intend to cite",
            "ruleIds": "Rule IDs you intend to cite in governing_rules"
        }
    },
    "descriptions": {
        "get_task_summary": "Get a cheap task overview (tool usage counts, top files touched, top commands run, first user message) aggregated over the task's earliest events, window many, default 400. The response's truncated/totalEventCount fields tell you whether later events were left out.",
        "get_task_events": "Get a page of a task's chronological event sequence (user messages, assistant messages, tool runs), up to 300 events per page. You choose how much to read: pick limit, pass the response's nextCursor back as cursor to keep paging, and set order=\"desc\" to start from the latest events. truncated/total tell you whether more events exist.",
        "list_rules": "List existing global and task-scoped rules that apply to the anchor task, so friction a rule already governs is cited by rule ID in governing_rules instead of re-described.",
        "search_events": "Search indexed events by title/body, ranked by recency. Use q with optional taskId, kind, or toolName filters to find user corrections, instructions, and friction evidence. Pick limit (up to 100 per call) and offset to page through as many results as you need.",
        "find_similar_tasks": "Find tasks with titles similar to the anchor task. Use after inspecting the anchor to check whether the workflow repeats.",
        "search_recipes": "Search existing recipes for possible duplicate or outdated targets. Use this before setting revises_recipe_id.",
        "check_citations": "Check whether the IDs you plan to cite are backed by what your tools actually returned, before you write the final candidates. Pass the task plus the event, turn, and rule IDs you intend to use; the response names the ones that are not citable. A single unsupported ID gets the whole candidate list rejected, so verify here instead of spending your one repair on it."
    }
}
