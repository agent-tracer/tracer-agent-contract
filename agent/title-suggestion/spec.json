{
    "id": "title-suggestion",
    "jobKind": "title.suggestion",
    "route": "/agents/title-suggestion",
    "prompt": {
        "fragments": {
            "contextShape": [
                "The user message carries the task's current title and an excerpt of its conversation turns (what the",
                "user asked, what the agent reported back): the oldest user turn plus the most recent turns. Turns in",
                "the middle are dropped when the task is long, and the excerpt says so when that happened."
            ],
            "titleSpec": [
                "Each title must be concrete — naming the area or action — under 80 characters, and normally 4-9 words",
                "in languages where words are space-delimited. Prefer an imperative or noun phrase, as in \"Fix auth",
                "middleware token leak\" or \"Migrate billing schema to v2\". Never use a placeholder such as \"Task 123\",",
                "\"Untitled\", or \"Test\"."
            ],
            "answerShape": [
                "If the current title is already concrete, accurate, and readable, return an empty list: that is a",
                "real answer, not a failure. Otherwise return exactly 2-3 distinct alternatives. Do not repeat the",
                "current title or another suggestion. Each rationale is one evidence-grounded sentence under 200",
                "characters explaining what drove the suggestion. Do not invent work the evidence does not show."
            ],
            "repairDirective": [
                "Change only what is necessary to satisfy these errors. Return either an empty suggestions list or 2-3",
                "distinct alternatives. Do not repeat the current title, use placeholder titles, or invent work the",
                "evidence does not show. Then return the complete repaired suggestion list."
            ]
        }
    },
    "tools": {
        "limits": {
            "recentTurnLimit": 20,
            "maxContextTurns": 21
        },
        "getTaskEvents": {
            "required": [
                "taskId"
            ],
            "optional": [
                "limit",
                "cursor",
                "order"
            ],
            "limit": {
                "default": 100,
                "min": 1,
                "max": 300
            },
            "order": {
                "default": "asc",
                "values": [
                    "asc",
                    "desc"
                ]
            }
        },
        "responses": {
            "get_task_events": {
                "page": [
                    "events",
                    "truncated",
                    "nextCursor",
                    "total"
                ],
                "item": [
                    "id",
                    "seq",
                    "kind",
                    "title",
                    "body",
                    "toolName",
                    "filePaths",
                    "occurredAt"
                ]
            }
        },
        "failures": {
            "toolFailed": "Tool {tool} failed: {reason}. Do not call it again more than once. Continue with the evidence you already have, and state in your rationale which evidence you could not check."
        },
        "argDescriptions": {
            "get_task_events": {
                "taskId": "The task ID",
                "limit": "Max events to return in this page (default 100, hard cap 300)",
                "cursor": "Opaque cursor from a previous call's nextCursor. Omit to start from the first page.",
                "order": "Reading direction: \"asc\" (default) pages from the earliest event forward; \"desc\" pages from the latest event backward."
            }
        },
        "descriptions": {
            "get_task_events": "Get a page of a task's chronological event sequence (user messages, assistant messages, tool runs), up to 300 events per page. You choose how much to read: pick limit, pass the response's nextCursor back as cursor to keep paging, and set order=\"desc\" to start from the latest events (e.g. to see how a long task ended). truncated/total tell you whether more events exist. Call this when the conversation excerpt in the prompt is too thin to name the work."
        }
    },
    "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "title.suggestion.list",
        "description": "지금의 제목이 적절하면 빈 배열이고 아니면 2~3개이며, 모자란 개수는 구현체의 검증기가 잡고 여기에는 폭주를 끊는 상한만 둔다.",
        "type": "object",
        "required": [
            "suggestions"
        ],
        "properties": {
            "suggestions": {
                "type": "array",
                "maxItems": 3,
                "items": {
                    "type": "object",
                    "required": [
                        "title",
                        "rationale"
                    ],
                    "properties": {
                        "title": {
                            "type": "string",
                            "trim": true,
                            "minLength": 1,
                            "maxLength": 80
                        },
                        "rationale": {
                            "type": "string",
                            "trim": true,
                            "minLength": 1,
                            "maxLength": 200
                        }
                    }
                }
            }
        }
    },
