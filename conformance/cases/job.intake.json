{
    "name": "job.intake",
    "meaning": "브라우저가 구현체마다 본문을 가르지 않도록 잡 접수와 조회와 취소 표면을 대조한다.",
    "path": "/api/v1/jobs",
    "cancelPath": "/api/v1/jobs/{id}/cancel",
    "acceptedStatus": 202,
    "userHeader": {
        "name": "x-monitor-user",
        "defaultValue": "local"
    },
    "kinds": [
        "title.suggestion",
        "recipe.scan",
        "task.cleanup"
    ],
    "body": {
        "fields": [
            "kind",
            "input",
            "idempotencyKey"
        ],
        "constraints": {
            "kind": {
                "required": true,
                "enum": [
                    "title.suggestion",
                    "recipe.scan",
                    "task.cleanup"
                ]
            },
            "input": {
                "required": false,
                "type": "object",
                "default": {}
            },
            "idempotencyKey": {
                "required": false,
                "minLength": 1,
                "maxLength": 200
            }
        }
    },
    "inputs": {
        "title.suggestion": {
            "required": [
                "taskId"
            ],
            "optional": [],
            "constraints": {
                "taskId": {
                    "minLength": 1,
                    "maxLength": 64
                }
            }
        },
        "recipe.scan": {
            "required": [
                "taskId"
            ],
            "optional": [
                "userPrompt",
                "language",
                "trigger"
            ],
            "constraints": {
                "taskId": {
                    "minLength": 1,
                    "maxLength": 64
                },
                "userPrompt": {
                    "minLength": 1,
                    "maxLength": 4000
                },
                "language": {
                    "minLength": 1,
                    "maxLength": 16
                },
                "trigger": {
                    "enum": [
                        "dashboard",
                        "session"
                    ]
                }
            }
        },
        "task.cleanup": {
            "required": [],
            "optional": [
                "filters.maxSuggestions"
            ],
            "constraints": {
                "filters.maxSuggestions": {
                    "minimum": 1,
                    "maximum": 50
                }
            }
        }
    },
    "cases": [
        {
            "name": "태스크에 매인 잡을 접수한다",
            "body": {
                "kind": "title.suggestion",
                "input": {
                    "taskId": "t1"
                }
            },
            "accepted": true
        },
        {
            "name": "레시피 스캔의 선택 입력을 함께 접수한다",
            "body": {
                "kind": "recipe.scan",
                "input": {
                    "taskId": "t1",
                    "language": "ko",
                    "trigger": "dashboard"
                },
                "idempotencyKey": "k1"
            },
            "accepted": true
        },
        {
            "name": "정리 제안은 도메인 입력 없이 접수한다",
            "body": {
                "kind": "task.cleanup",
                "input": {}
            },
            "accepted": true
        },
        {
            "name": "필수 입력이 빠지면 거절한다",
            "body": {
                "kind": "title.suggestion",
                "input": {}
            },
            "accepted": false
        },
        {
            "name": "상한을 넘는 제안 수를 거절한다",
            "body": {
                "kind": "task.cleanup",
                "input": {
                    "filters": {
                        "maxSuggestions": 51
                    }
                }
            },
            "accepted": false
        }
    ],
    "rejections": [
        {
            "name": "본문이 스키마를 만족하지 않는다",
            "status": 400,
            "code": "validation_error",
            "message": "Invalid request"
        }
    ],
    "response": {
        "meaning": "접수와 조회와 취소가 모두 원장 행 하나를 같은 칸으로 낸다. 봉투를 벗긴 data를 대조하며 jobFields라 적은 자리는 그 칸 목록을, jobFields[]는 그 배열을, jobFields?는 그 모양이거나 비어 있음을 요구한다.",
        "jobFields": [
            "id",
            "userId",
            "kind",
            "executor",
            "status",
            "attempts",
            "taskId",
            "input",
            "result",
            "usage",
            "error",
            "createdAt",
            "updatedAt",
            "startedAt",
            "completedAt"
        ],
        "usage": {
            "meaning": "usage 전체의 모양은 job.usage.shape가 갖는다. 여기는 화면이 그대로 보여주는 model 칸 하나의 값을 못 박는다",
            "model": {
                "value": "이 시도를 태운 모델의 별칭이며 실행 봉투가 건넨 식별자를 그대로 적는다",
                "example": "claude-haiku-4-5",
                "forbidden": "판까지 붙은 식별자 — claude-haiku-4-5-20251001",
                "fallback": "물러선 모델이 태웠으면 그 모델의 별칭을 적는다",
                "rateKey": "modelRates의 키와 같은 값이므로 한 기록 안에서 model과 costUsd가 같은 모델을 가리킨다",
                "onFailure": "공급자가 답하기 전에 실패해도 봉투가 건넨 값을 알기 때문에 이 칸은 비지 않는다",
                "actualModel": "공급자가 실제로 답한 판까지 붙은 식별자는 실행 관측 기록의 자기 칸이 갖는다. usage는 그것을 싣지 않는다"
            }
        },
        "enqueue": {
            "status": 202,
            "data": {
                "job": "jobFields"
            }
        },
        "get": {
            "path": "/api/v1/jobs/{id}",
            "status": 200,
            "data": {
                "job": "jobFields"
            }
        },
        "pending": {
            "meaning": "종류를 골라 대기 잡만 내며 status를 실으려면 pending이어야 한다",
            "path": "/api/v1/jobs",
            "status": 200,
            "query": {
                "kind": {
                    "required": true,
                    "enum": "ledgerKinds"
                },
                "status": {
                    "required": false,
                    "enum": [
                        "pending"
                    ]
                }
            },
            "order": "createdAt 오름차순",
            "data": {
                "items": "jobFields[]"
            }
        },
        "history": {
            "meaning": "이력을 한 페이지씩 내고 상한과 건너뛰기를 뺀 전체 개수를 함께 싣는다",
            "path": "/api/v1/jobs/history",
            "status": 200,
            "query": {
                "kind": {
                    "required": false,
                    "enum": "ledgerKinds"
                },
                "status": {
                    "required": false,
                    "enum": [
                        "pending",
                        "running",
                        "completed",
                        "failed",
                        "canceled"
                    ]
                },
                "limit": {
                    "required": false,
                    "minimum": 1,
                    "maximum": 100,
                    "default": 50
                },
                "offset": {
                    "required": false,
                    "minimum": 0,
                    "default": 0
                }
            },
            "order": "createdAt 내림차순",
            "data": {
                "items": "jobFields[]",
                "total": "integer"
            }
        },
        "latest": {
            "meaning": "사용자와 종류와 태스크 조합의 가장 최근 잡이며 없으면 job이 비어 있다",
            "path": "/api/v1/jobs/latest",
            "status": 200,
            "query": {
                "kind": {
                    "required": true,
                    "enum": "ledgerKinds"
                },
                "taskId": {
                    "required": false,
                    "minLength": 1
                }
            },
            "data": {
                "job": "jobFields?"
            }
        },
        "cancel": {
            "status": 200,
            "data": {
                "job": "jobFields"
            }
        },
        "steps": {
            "path": "/api/v1/jobs/{id}/steps",
            "status": 200,
            "order": [
                "attempt",
                "seq"
            ],
            "required": [
                "seq",
                "attempt",
                "role",
                "content",
                "truncated",
                "toolCalls"
            ],
            "optional": [
                "toolName",
                "toolCallId",
                "inputTokens",
                "outputTokens",
                "cacheReadTokens",
                "cacheCreationTokens",
                "stopReason",
                "nodeName",
                "eventKind",
                "durationMs"
            ],
            "omitsNull": true
        },
        "notFound": {
            "status": 404,
            "meaning": "남의 잡은 존재 여부도 드러내지 않으므로 같은 404를 낸다"
        },
        "ledgerKinds": [
            "title.suggestion",
            "recipe.scan",
            "task.cleanup",
            "rule.generation"
        ],
        "envelopeRejection": {
            "status": 400,
            "meaning": "봉투를 발급할 수 없다. 자격이 없거나 워크플로가 태우지 않는 종류다",
            "chat": {
                "path": "/internal/chat/executions/{executionId}/envelope",
                "code": "chat.llm-key-missing"
            },
            "jobs": {
                "path": "/internal/jobs/{kind}/envelope",
                "code": "job.llm-key-missing"
            }
        }
    }
}
