{
  "meaning": "조사 프롬프트가 실어 보내는 값의 자리를 두 구현체가 같게 내는지 대조하는 케이스다. 프롬프트 전문이 아니라 반드시 실려야 하는 줄과 실리면 안 되는 것을 적으므로, 조립의 나머지는 구현체가 자유롭게 쓴다. 모델이 읽는 글자가 축마다 다르면 같은 태스크가 축에 따라 다른 답을 내고 그 원인이 보이지 않는다.",
  "survey": {
    "meaning": "조율자가 계획을 세울 때 읽는 사용자 프롬프트다.",
    "cases": [
      {
        "name": "앵커와 쓸 수 있는 턴을 함께 싣는다",
        "input": {
          "taskId": "task-1",
          "availableTurns": 9,
          "userPrompt": null
        },
        "mustContain": [
          "task-1",
          "Turns available: 9"
        ]
      },
      {
        "name": "사용자 지시가 있으면 그것도 싣는다",
        "input": {
          "taskId": "task-1",
          "availableTurns": 9,
          "userPrompt": "배포 절차를 보고 싶다"
        },
        "mustContain": [
          "task-1",
          "Turns available: 9",
          "배포 절차를 보고 싶다"
        ]
      }
    ]
  },
  "probe": {
    "meaning": "전문가가 자기 조사를 시작할 때 읽는 사용자 프롬프트다.",
    "cases": [
      {
        "name": "앵커와 자기 질문과 쓸 수 있는 턴을 싣는다",
        "input": {
          "taskId": "task-1",
          "question": "이 태스크가 무엇을 했나",
          "turns": 4,
          "siblings": []
        },
        "mustContain": [
          "task-1",
          "이 태스크가 무엇을 했나",
          "Turns available: 4"
        ],
        "mustNotContain": [
          "Other specialists are handling"
        ]
      },
      {
        "name": "다른 전문가가 맡은 축과 질문을 함께 싣는다",
        "input": {
          "taskId": "task-1",
          "question": "이 태스크가 무엇을 했나",
          "turns": 4,
          "siblings": [
            {
              "probe": "rules",
              "depth": "normal",
              "question": "어떤 규칙이 걸렸나"
            },
            {
              "probe": "repetition",
              "depth": "shallow",
              "question": "다른 태스크에도 있었나"
            }
          ]
        },
        "mustContain": [
          "Other specialists are handling these questions in parallel:",
          "rules",
          "어떤 규칙이 걸렸나",
          "repetition",
          "다른 태스크에도 있었나"
        ]
      },
      {
        "name": "단독으로 실행되는 전문가에게는 남의 담당을 싣지 않는다",
        "input": {
          "taskId": "task-1",
          "question": "이 태스크가 무엇을 했나",
          "turns": 4,
          "siblings": []
        },
        "mustNotContain": [
          "Other specialists are handling",
          "rules",
          "repetition"
        ]
      }
    ]
  },
  "investigate": {
    "meaning": "조율자가 종합할 때 읽는 사용자 프롬프트다. 조율자는 도구를 갖지 않으므로 인용할 수 있는 식별자를 요청이 직접 실어 준다. 이 목록이 축마다 다르면 한 축은 인용할 수 있는 것을 인용하지 못한다.",
    "cases": [
      {
        "name": "장부가 비어 있으면 인용 목록을 싣지 않는다",
        "input": {
          "taskId": "task-1",
          "provenance": {
            "eventIdsByTask": {},
            "turnIdsByTask": {},
            "ruleIds": [],
            "recipeRevs": {}
          }
        },
        "mustNotContain": [
          "Citable identifiers"
        ]
      },
      {
        "name": "태스크마다 이벤트와 턴을 갈라 싣고 규칙과 레시피를 뒤에 싣는다",
        "input": {
          "taskId": "task-1",
          "provenance": {
            "eventIdsByTask": {
              "task-2": [
                "e-3"
              ],
              "task-1": [
                "e-2",
                "e-1"
              ]
            },
            "turnIdsByTask": {
              "task-1": [
                "t-1"
              ]
            },
            "ruleIds": [
              "rule-b",
              "rule-a"
            ],
            "recipeRevs": {
              "recipe-1": 3
            }
          }
        },
        "mustContain": [
          "Citable identifiers (nothing outside this list may appear in your output):",
          "- task-1 events: e-1, e-2",
          "- task-1 turns: t-1",
          "- task-2 events: e-3",
          "- rules: rule-a, rule-b",
          "- recipes: recipe-1@3"
        ]
      },
      {
        "name": "상한을 넘은 식별자는 앞에서 자르고 남은 수를 알린다",
        "input": {
          "taskId": "task-1",
          "citableIdListLimit": 2,
          "provenance": {
            "eventIdsByTask": {
              "task-1": [
                "e-1",
                "e-2",
                "e-3",
                "e-4"
              ]
            },
            "turnIdsByTask": {},
            "ruleIds": [],
            "recipeRevs": {}
          }
        },
        "mustContain": [
          "- task-1 events: e-1, e-2 (+2 more)"
        ],
        "mustNotContain": [
          "e-3",
          "e-4"
        ]
      }
    ]
  },
  "probeSystem": {
    "meaning": "전문가가 자기 보고를 쓸 때 읽는 시스템 프롬프트다. 보고를 자르는 상한이 여기 실리지 않으면 전문가는 그 상한을 거절로만 알게 되고, 거절 한 번이 조사 턴 하나를 소모한다. 근거를 다 모으고도 보고를 낼 턴이 남지 않으면 그 조사의 결과는 남지 않는다. mustContainLimits 는 계약의 limits 에서 값을 찾아 대조하므로 이 자리가 숫자를 복제하지 않는다.",
    "cases": [
      {
        "name": "보고를 자르는 상한을 모두 싣는다",
        "input": {},
        "mustContainLimits": [
          "probeVerdictChars",
          "probeExcerptChars",
          "maxProbeExcerpts"
        ]
      }
    ]
  },
  "investigateSystem": {
    "meaning": "조율자가 후보를 쓸 때 읽는 시스템 프롬프트다. 낼 수 있는 칸의 설명이 여기 실리지 않으면 모델은 그 칸을 비운 채 내고, 스키마만 넓힌 계약은 아무것도 바꾸지 못한다.",
    "cases": [
      {
        "name": "새로 더한 칸의 설명과 그 근거 요구를 함께 싣는다",
        "input": {
          "recipeCandidateLimit": 4,
          "maxRedispatchProbes": 3,
          "maxRedispatchRounds": 1
        },
        "mustContainLimits": [
          "recipeCandidateLimit",
          "maxRedispatchProbes",
          "maxRedispatchRounds"
        ],
        "mustContain": [
          "the conditions under which this recipe applies",
          "what had to be in place before this work could start.",
          "what actually existed once the work finished",
          "list of {symptom, action, evidence, stepOrder?}",
          "the eventIds that actually show that step being carried out",
          "Optionally add why (what the file contributes to this workflow) and loadWhen",
          "Do NOT invent a use_when, an output, or a recovery the trajectory did not show"
        ]
      }
    ]
  }
}
