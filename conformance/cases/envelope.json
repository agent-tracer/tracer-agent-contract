{
    "name": "envelope",
    "meaning": "구현체가 payload 하나를 응답 봉투로 성형한 결과를 대조한다.",
    "success": [
        {
            "name": "객체 payload를 data에 그대로 싣는다",
            "payload": { "job": { "id": "j1" } },
            "envelope": { "ok": true, "data": { "job": { "id": "j1" } } }
        },
        {
            "name": "실을 값이 없으면 data를 null로 적는다",
            "payload": null,
            "envelope": { "ok": true, "data": null }
        },
        {
            "name": "이미 봉투 형태면 다시 포장하지 않는다",
            "payload": { "ok": true, "data": { "count": 2 } },
            "envelope": { "ok": true, "data": { "count": 2 } }
        },
        {
            "name": "ok만 있고 data가 없으면 나머지 키를 data로 삼는다",
            "payload": { "ok": true, "count": 2 },
            "envelope": { "ok": true, "data": { "count": 2 } }
        },
        {
            "name": "ok 말고 남는 키가 없으면 data는 null이다",
            "payload": { "ok": true },
            "envelope": { "ok": true, "data": null }
        },
        {
            "name": "배열 payload는 봉투로 보지 않고 data에 싣는다",
            "payload": [1, 2],
            "envelope": { "ok": true, "data": [1, 2] }
        }
    ],
    "failure": [
        {
            "name": "근거가 없으면 details를 싣지 않는다",
            "code": "not_found",
            "message": "Thread not found",
            "envelope": {
                "ok": false,
                "error": { "code": "not_found", "message": "Thread not found" }
            }
        },
        {
            "name": "근거가 있으면 details를 싣는다",
            "code": "validation_error",
            "message": "Invalid request",
            "details": [{ "loc": ["content"], "type": "string_too_short" }],
            "envelope": {
                "ok": false,
                "error": {
                    "code": "validation_error",
                    "message": "Invalid request",
                    "details": [{ "loc": ["content"], "type": "string_too_short" }]
                }
            }
        }
    ],
    "recognition": [
        {
            "name": "성공 봉투로 읽는다",
            "value": { "ok": true, "data": null },
            "success": true,
            "failure": false
        },
        {
            "name": "data 키가 없으면 성공 봉투가 아니다",
            "value": { "ok": true },
            "success": false,
            "failure": false
        },
        {
            "name": "오류 봉투로 읽는다",
            "value": { "ok": false, "error": { "code": "not_found", "message": "없다" } },
            "success": false,
            "failure": true
        },
        {
            "name": "code가 문자열이 아니면 오류 봉투가 아니다",
            "value": { "ok": false, "error": { "code": 404, "message": "없다" } },
            "success": false,
            "failure": false
        }
    ]
}
