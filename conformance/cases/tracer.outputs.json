{
    "name": "tracer.outputs",
    "meaning": "에이전트가 만든 산출물이 추적 API의 공개 창구로만 들어가므로 그 창구의 요청과 응답의 칸을 대조한다. shapes가 응답의 칸 목록을, drafts가 요청 한 건의 칸 목록을, windows가 창구마다 봉투를 벗긴 data의 모양을 shape 이름으로 가리킨다. 두 구현체가 이 파일에서 목록을 읽어 자기 요청과 응답을 대조한다.",
    "notation": {
        "shape": "shapes의 이름 하나이며 그 칸 목록을 그대로 요구한다",
        "shape[]": "그 모양의 배열이다"
    },
    "userHeader": {
        "name": "x-monitor-user",
        "defaultValue": "local"
    },
    "surface": "http/tracer-dependency.openapi.yaml",
    "shapes": {
        "recipe": {
            "meaning": "레시피 원장 행 하나이며 생성과 조회와 상태 변경이 모두 이 칸을 낸다. 적용 통계는 목록 창구가 따로 싣는 값이라 이 모양에 없다",
            "fields": [
                "id",
                "userId",
                "status",
                "title",
                "intent",
                "description",
                "summaryMd",
                "request",
                "corrections",
                "pitfalls",
                "governingRules",
                "steps",
                "touchedFiles",
                "contributingSlices",
                "rationale",
                "language",
                "rev",
                "parentRecipeId",
                "sourceJobId",
                "userEdited",
                "lastEditedBy",
                "error",
                "createdAt",
                "updatedAt",
                "resolvedAt"
            ]
        },
        "cleanupSuggestion": {
            "meaning": "정리 제안 원장 행 하나이며 생성과 조회와 해소가 모두 이 칸을 낸다",
            "fields": [
                "id",
                "userId",
                "jobId",
                "taskId",
                "kind",
                "currentValue",
                "proposedValue",
                "rationale",
                "status",
                "error",
                "createdAt",
                "resolvedAt"
            ]
        }
    },
    "drafts": {
        "recipe": {
            "meaning": "레시피 하나를 만드는 요청 항목이며 식별자와 상태와 판은 싣지 않는다",
            "required": [
                "title",
                "intent",
                "description",
                "summaryMd",
                "request",
                "rationale",
                "contributingSlices"
            ],
            "optional": [
                "corrections",
                "pitfalls",
                "governingRules",
                "steps",
                "touchedFiles",
                "language",
                "parentRecipeId",
                "parentRecipeSeenRev"
            ],
            "slice": [
                "taskId",
                "turnIds",
                "eventIds"
            ],
            "constraints": {
                "title": { "minLength": 1, "maxLength": 120 },
                "intent": { "minLength": 1, "maxLength": 200 },
                "description": { "minLength": 1, "maxLength": 400 },
                "summaryMd": { "minLength": 1, "maxLength": 4000 },
                "request": { "minLength": 1, "maxLength": 2000 },
                "rationale": { "minLength": 1, "maxLength": 500 },
                "contributingSlices": { "minItems": 1, "maxItems": 20 },
                "corrections": { "maxItems": 20 },
                "pitfalls": { "maxItems": 20 },
                "governingRules": { "maxItems": 50 },
                "steps": { "maxItems": 20, "consecutiveOrderFrom": 1 },
                "touchedFiles": { "maxItems": 30 }
            }
        },
        "cleanupSuggestion": {
            "meaning": "정리 제안 하나를 만드는 요청 항목이다",
            "required": [
                "taskId",
                "kind",
                "rationale"
            ],
            "optional": [],
            "constraints": {
                "taskId": { "minLength": 1, "maxLength": 64 },
                "kind": { "enum": ["archive"] },
                "rationale": { "minLength": 1, "maxLength": 500 }
            }
        }
    },
    "windows": [
        {
            "name": "레시피 후보를 한 벌로 만든다",
            "method": "POST",
            "path": "/api/v1/recipes",
            "status": 201,
            "body": {
                "required": ["recipes", "author"],
                "optional": ["sourceJobId"],
                "constraints": {
                    "recipes": { "minItems": 1, "maxItems": 20, "item": "draft.recipe" },
                    "author": { "enum": ["agent", "user"] },
                    "sourceJobId": { "minLength": 1, "maxLength": 200 }
                }
            },
            "data": { "recipes": "recipe[]" },
            "order": "요청에 실린 순서를 그대로 지킨다"
        },
        {
            "name": "정리 제안을 한 벌로 만든다",
            "method": "POST",
            "path": "/api/v1/task-cleanup/suggestions",
            "status": 201,
            "body": {
                "required": ["suggestions"],
                "optional": ["jobId"],
                "constraints": {
                    "suggestions": { "minItems": 1, "maxItems": 50, "item": "draft.cleanupSuggestion" },
                    "jobId": { "minLength": 1, "maxLength": 200 }
                }
            },
            "data": { "suggestions": "cleanupSuggestion[]" },
            "order": "요청에 실린 순서를 그대로 지킨다"
        }
    ],
    "derived": {
        "meaning": "요청이 싣지 않고 창구가 정하는 값이다. 부르는 쪽마다 다른 값을 실으면 같은 산출물이 두 모양이 되므로 여기에 못 박는다",
        "recipe": {
            "id": "창구가 만든다. 부르는 쪽이 실은 값을 쓰지 않는다",
            "status": "candidate",
            "rev": "부모가 있으면 부모의 rev에 하나를 더하고 없으면 1이다",
            "parentRecipeId": "parentRecipeId가 지금 이 사용자의 레시피를 가리키고 그 판이 parentRecipeSeenRev와 같을 때만 적는다. 어긋나면 비운다",
            "userEdited": "author가 user면 참이고 agent면 거짓이다",
            "lastEditedBy": "author를 그대로 적는다",
            "error": "비운다",
            "resolvedAt": "비운다",
            "sourceJobId": "요청의 값을 그대로 적고 싣지 않으면 비운다"
        },
        "cleanupSuggestion": {
            "id": "창구가 만든다",
            "status": "pending",
            "jobId": "요청의 값을 그대로 적고 싣지 않으면 빈 문자열이다",
            "currentValue": "비운다",
            "proposedValue": "비운다",
            "error": "비운다",
            "resolvedAt": "비운다",
            "observedLastEventAt": "창구가 태스크의 lastEventAt을 읽어 적는다. 응답에는 싣지 않으며 해소 시점의 낡음 판정이 이 값을 본다"
        }
    },
    "transaction": {
        "meaning": "산출물 쓰기가 배포 단위를 건너가므로 원자성을 어디가 지키는지 계약이 정한다",
        "boundary": "창구 하나가 한 트랜잭션이다. 레시피 창구는 후보 전부와 그 색인 적재 행 전부를 함께 쓰고, 정리 창구는 제안 전부를 함께 쓴다",
        "searchIndex": "색인 반영은 추적 서비스가 자기 적재 행을 비우며 한다. 부르는 쪽은 색인을 모른다",
        "onFailure": "한 호출은 전부 쓰이거나 아무것도 쓰이지 않는다. 부르는 쪽이 응답을 받지 못하면 남은 것은 둘 중 하나뿐이고 어느 쪽이든 같은 본문을 다시 보내는 것으로 수습한다",
        "callerLedger": "부르는 쪽의 실행 원장은 자기 데이터베이스 안에서 끝난다. 두 원장을 걸치는 트랜잭션이 없다"
    },
    "idempotency": {
        "meaning": "실행이 여러 번 시도되므로 같은 본문이 두 번 닿을 수 있다. 두 창구가 그때 원장을 늘리지 않는다",
        "recipes": {
            "key": "sourceJobId",
            "rule": "그 값으로 만들어진 후보가 이미 있으면 아무것도 쓰지 않고 그 후보를 낸다",
            "status": 200,
            "absent": "sourceJobId를 싣지 않으면 대조하지 않고 언제나 새로 만든다"
        },
        "cleanupSuggestions": {
            "key": "taskId + kind",
            "rule": "같은 태스크와 종류에 pending인 제안이 있으면 그 행의 rationale과 jobId와 observedLastEventAt을 새 것으로 고치고 새 행을 만들지 않는다",
            "status": 201,
            "resolved": "accepted이거나 dismissed인 행은 건드리지 않고 새 pending 행을 만든다"
        }
    },
    "rejections": [
        {
            "name": "본문이 스키마를 만족하지 않는다",
            "status": 400,
            "code": "validation_error",
            "message": "Invalid request"
        },
        {
            "name": "정리 제안이 가리키는 태스크가 이 사용자의 것이 아니다",
            "status": 404,
            "code": "not_found",
            "message": "Task not found"
        }
    ],
    "unvalidated": {
        "meaning": "인용은 근거이지 참조 무결성이 아니므로 창구가 존재를 검사하지 않는다. 검사하면 뒤늦게 지워진 이벤트 하나가 산출물 한 벌을 통째로 막는다",
        "paths": [
            "recipes[].contributingSlices[].taskId",
            "recipes[].contributingSlices[].turnIds",
            "recipes[].contributingSlices[].eventIds",
            "recipes[].corrections[].evidence",
            "recipes[].pitfalls[].evidence",
            "recipes[].governingRules"
        ]
    }
}
